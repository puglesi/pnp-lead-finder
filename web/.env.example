# =============================================================================
# PNP Lead Finder — variáveis de ambiente
#
# LOCAL:  copie para .env.local
#         cp .env.example .env.local   (Mac/Linux)
#         copy .env.example .env.local (Windows)
#
# VERCEL: Settings → Environment Variables (não commite .env.local)
# Guia:  DEPLOY-VERCEL.md
# =============================================================================

# URL pública do app — OBRIGATÓRIA em produção (tracking de email)
# Vercel:  https://seu-projeto.vercel.app  (sem barra no final)
# Local:   http://localhost:3000
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Busca de leads — SerpAPI (recomendado)
# https://serpapi.com/manage-api-key
# -----------------------------------------------------------------------------
SERPAPI_KEY=

# -----------------------------------------------------------------------------
# Google Custom Search (opcional)
# https://developers.google.com/custom-search
# -----------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# -----------------------------------------------------------------------------
# Tracking de campanhas em produção (opcional, recomendado na Vercel)
# Crie um banco Redis gratuito em: Vercel Dashboard → Storage → Upstash Redis
# A Vercel injeta automaticamente KV_REST_API_URL e KV_REST_API_TOKEN
# -----------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# -----------------------------------------------------------------------------
# Agente 3 - Gmail SMTP server-only
# Mantenha desativado ate revisar as campanhas e preencher as credenciais locais.
# A suppression list aceita emails separados por virgula, ponto e virgula ou espaco.
# -----------------------------------------------------------------------------
AGENT3_REAL_SEND_ENABLED=false
AGENT3_SUPPRESSION_LIST=

PNP_SMTP_HOST=smtp.example.invalid
PNP_SMTP_PORT=465
PNP_SMTP_SECURE=true
PNP_SMTP_USER=sender-pnp@example.invalid
PNP_SMTP_APP_PASSWORD=replace-with-pnp-app-password
PNP_FROM_NAME=replace-with-pnp-display-name
PNP_REPLY_TO=reply-pnp@example.invalid

MODECLEAN_SMTP_HOST=smtp.example.invalid
MODECLEAN_SMTP_PORT=465
MODECLEAN_SMTP_SECURE=true
MODECLEAN_SMTP_USER=sender-modeclean@example.invalid
MODECLEAN_SMTP_APP_PASSWORD=replace-with-modeclean-app-password
MODECLEAN_FROM_NAME=replace-with-modeclean-display-name
MODECLEAN_REPLY_TO=reply-modeclean@example.invalid

# -----------------------------------------------------------------------------
# Email providers (Mailgun, Resend, SES, Brevo, SendGrid, SMTP)
# Configurados pela UI em Configurações → credenciais (armazenados no browser).
# Não é necessário definir aqui, exceto se você mover para server-only no futuro.
# -----------------------------------------------------------------------------
